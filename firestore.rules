rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Students can only edit their own profile fields — NOT role, suspended,
      // courseProgress, or membership. Only an admin can change those.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name','phone','country','bio','photoURL']))
        || isAdmin()
      );
      allow delete: if isAdmin();

      match /attendance/{date} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }
    }

    match /courses/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /videos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /notes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /payments/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /certificates/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
